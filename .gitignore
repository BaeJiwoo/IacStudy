# Terraform working directories
**/.terraform/*

# Terraform state and plan artifacts
*.tfstate
*.tfstate.*
*.tfplan
*.plan
crash.log
crash.*.log

# Local Terraform variable files
terraform.tfvars
terraform.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
!*.example.tfvars
!*.example.tfvars.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Environment files and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Local editor and operating system files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Node.js and AWS CDK generated files
**/node_modules/
**/dist/
**/cdk.out/

# AWS SAM generated files
**/.aws-sam/
samconfig.toml

# Local CloudFormation packaging and output
packaged.yaml
change-set-output.json

# Python generated files
**/__pycache__/
*.pyc
